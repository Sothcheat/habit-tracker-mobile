# Supabase project settings -> Data API / API Keys
# Only ever the anon key — anything EXPO_PUBLIC_ ships inside the app bundle.
# RLS is what keeps data private; a service-role key here would hand every
# installed copy of the app full access to the database.
EXPO_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
